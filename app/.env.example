# Copy this file to `.env` (in the `app/` directory) and fill in real values.
# NEVER commit a `.env` containing real credentials to version control.

# PostgreSQL connection string for My Eyes.
DATABASE_URL=postgresql://user:password@localhost:5432/myeyes

# GOOGLE OAUTH (Sign in with Google)
# This is the Web application OAuth client ID from Google Cloud Console. It is
# safe to identify the client, but keep it in .env so Android and FastAPI can
# be configured together. The OAuth client secret is NOT used for ID-token
# verification and must never be put in Flutter.
GOOGLE_OAUTH_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# AI HELP (Gemini API - Free Tier)
# ---------------------------------------------------------------------------
# The Gemini API key lives ONLY on the server. It is never sent to or stored
# on the Flutter device, never returned in an API response and never logged.
# Keep this value private.
# Create a key at https://aistudio.google.com/apikey (leave billing UNLINKED
# so the project stays on the Free Tier).
GEMINI_API_KEY=

# Model used by AI Help. It must be a Gemini model this key can actually call;
# otherwise the API answers 404 and AI Help reports a configuration error
# rather than silently switching to a different (possibly paid) model.
#
# gemini-3.8-flash is the default because Google's pricing page lists free
# input AND output tokens for it on the Free Tier, and Google's models page
# recommends it for new projects. Check the current free tier yourself at
#   https://ai.google.dev/gemini-api/docs/pricing
# and change this value if a model you prefer becomes available or retires.
# To list the models your key can actually use:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# SMART NAVIGATION (Geoapify - OpenStreetMap based, free tier)
# ---------------------------------------------------------------------------
# Server-side key for the Geoapify Geocoding, Places and Routing APIs. Lives
# ONLY on the server; the Flutter device never sees it. The Android app needs
# NO map SDK key because navigation is voice-first with no map widget.
# Get a free key at https://myprojects.geoapify.com/ (3000 places + 3000
# geocoding requests/day on the free plan).
GEOAPIFY_API_KEY=

# ---------------------------------------------------------------------------
# SOS EMERGENCY DELIVERY (optional)
# ---------------------------------------------------------------------------
# My Eyes always alerts the user's emergency contacts. Without a value here the
# FASTAPI SERVER does not send anything itself: the Flutter app hands the
# message to the device's messaging and dialer apps instead (delivery_method
# "client" in POST /sos-events/trigger). That path already works.
#
# This project ships its own relay at POST /emergency-relay/sos
# (app/routers/emergency_relay_router.py) so there is something real to point
# at. The relay exists because the two halves have incompatible authentication:
#
#   * My Eyes speaks ONE shape - JSON body + `Authorization: Bearer <token>`.
#   * No SMS gateway accepts that. Twilio wants HTTP Basic + form encoding,
#     MSG91 wants its key in a header + its own envelope, Fast2SMS wants the key
#     in a query string.
#
# So EMERGENCY_ALERT_WEBHOOK_URL points at the RELAY, and the relay converts to
# whatever provider is configured. Pointing it straight at a gateway would fail
# authentication on every contact.
#
# The backend POSTs one JSON body per contact:
#   {"to","to_name","relationship","priority","message","user_name",
#    "user_email","location":{...}|null,"source":"my-eyes-sos"}
# A non-2xx or a timeout is recorded as "that contact was not reached" and the
# remaining contacts are still attempted, so one bad number can never abort the
# alert.
#
# --- 1) What My Eyes posts to -------------------------------------------
EMERGENCY_ALERT_WEBHOOK_URL=http://127.0.0.1:8000/emergency-relay/sos
# EMERGENCY_ALERT_WEBHOOK_TOKEN, when set, is sent as `Authorization: Bearer`.
# It must equal EMERGENCY_RELAY_TOKEN below.
EMERGENCY_ALERT_WEBHOOK_TOKEN=
# Seconds allowed for the delivery webhook per contact. Keep it short: SOS
# must never appear to hang because a gateway is slow.
EMERGENCY_ALERT_TIMEOUT=10

# --- 2) The relay ------------------------------------------------------
# Shared secret the relay requires. Must match the token above. If this is
# empty the relay refuses every request with 503 rather than sending, so an
# unauthenticated caller cannot spend the project's SMS credits.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
EMERGENCY_RELAY_TOKEN=
EMERGENCY_RELAY_TIMEOUT=10

# console | twilio | msg91 | fast2sms
# All three real providers send SMS to the contact's own phone number. There is
# no email option: an emergency contact record holds a phone number, and an
# alert that arrives in an inbox is not what they expect to receive.
#
# `console` logs the alert and sends nothing: use it to test the pipeline with
# no paid account. Every other value needs the matching credentials below.
EMERGENCY_RELAY_PROVIDER=console

# Twilio (https://try.twilio.com) - international, simplest signup.
EMERGENCY_RELAY_TWILIO_ACCOUNT_SID=
EMERGENCY_RELAY_TWILIO_AUTH_TOKEN=
EMERGENCY_RELAY_TWILIO_FROM=

# MSG91 (https://msg91.com) - India. DLT template approval is MANDATORY before
# a single message can be sent; without an approved template every alert fails.
EMERGENCY_RELAY_MSG91_AUTHKEY=
EMERGENCY_RELAY_MSG91_TEMPLATE_ID=
EMERGENCY_RELAY_MSG91_SENDER_ID=

# Fast2SMS (https://www.fast2sms.com) - India, no DLT.
EMERGENCY_RELAY_FAST2SMS_API_KEY=
EMERGENCY_RELAY_FAST2SMS_SENDER_ID=
