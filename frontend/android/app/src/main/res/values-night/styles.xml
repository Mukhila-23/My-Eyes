<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Mirrors values/styles.xml exactly. The app is dark-only, so the night
      variant must resolve to the same dark theme; keeping both files in step
      prevents a light window appearing when the system theme changes while the
      app is running.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackgroundFallback">@color/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>